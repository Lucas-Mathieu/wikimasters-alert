{
  "manifest_version": 3,
  "name": "WikiMasters Auction Alert",
  "version": "1.0.0",
  "description": "Alerte avant la fin des enchères ouvertes sur WikiMasters.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.wiki-masters.com/*"
  ],
  "action": {
    "default_title": "WikiMasters Auction Alert",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
